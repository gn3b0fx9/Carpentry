      "binding": "DB",
      "database_name": "carpentry-db",
      "database_id": ""d1_databases": [{
    "binding": "DB",
    "database_name": "carpentry-db",
    "database_id": "b9c27a19-b1fd-4e54-8b8e-63fea983586f"
 }]"
    }
  ]
}
