{
  "name": "carpentry",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpentry-db",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
